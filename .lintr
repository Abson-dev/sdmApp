linters: linters_with_defaults(
    object_name_linter(
      styles = c("snake_case", "camelCase", "symbols", "dotted.case"),
      regexes = c(sdmApp = "^[.]?sdmApp(_[A-Za-z]+)*$")
    ),
    line_length_linter(80L)
  )
exclusions: list(
    "vignettes/sdmApp.Rmd" = list(commented_code_linter = Inf)
  )
encoding: "UTF-8"
